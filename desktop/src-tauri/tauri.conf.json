{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeeMASH",
  "version": "0.13.4",
  "identifier": "one.kennet.keemash",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:sensor-host && npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KeeMASH",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#0b0e13"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "resources": ["vendor/librehardwaremonitor/*"],
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
