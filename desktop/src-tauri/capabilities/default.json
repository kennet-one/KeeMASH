{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Permissions for the KeeMASH main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-runtime-bootstrap",
    "allow-runtime-apply-action",
    "allow-runtime-history",
    "allow-runtime-dispatch",
    "allow-graphics-runtime-status",
    "allow-admin-graphics-set-master",
    "allow-admin-graphics-restart",
    "allow-admin-gpu-set-process-policy",
    "allow-admin-gpu-undo-process-policy",
    "allow-admin-gpu-remove-rule",
    "allow-admin-process-close",
    "allow-admin-process-terminate",
    "allow-admin-process-terminate-tree",
    "allow-admin-ccc-start",
    "allow-admin-ccc-stop",
    "allow-admin-ccc-restart",
    "allow-admin-memory-test-start",
    "allow-admin-memory-test-stop",
    "allow-admin-memory-diagnostic-open",
    "allow-admin-update-install",
    "allow-admin-system-reboot-to-firmware",
    "allow-admin-system-restart",
    "allow-admin-system-shutdown",
    "allow-admin-system-cancel-power",
    "allow-frontend-ready",
    "allow-mesh-status",
    "allow-mesh-pair",
    "allow-mesh-revoke",
    "allow-mesh-send"
  ]
}
